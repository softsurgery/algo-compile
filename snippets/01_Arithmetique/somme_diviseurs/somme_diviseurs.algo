Procedure Saisir(@n: Entier)
DEBUT
  Répéter
    Ecrire("Donner un entier strictement positif : ")
    Lire(n)
  Jusqu'à n > 0
FIN

Tableau de déclaration des objets locaux
Objet   Type / Nature
/       /

Fonction SommeDiviseurs(n: Entier) : Entier
DEBUT
  s <- 0
  Ecrire("Diviseurs de ", n, " : ")
  Pour d de 1 à n Faire
    Si (n Mod d) = 0 Alors
      Ecrire(d, "  ")
      s <- s + d
    FinSi
  Fin Pour
  Ecrire_nl("")
  Retourner s
FIN

Tableau de déclaration des objets locaux
Objet   Type / Nature
s, d    Entier

ALGORITHME CalculSommeDiviseurs
DEBUT
  Saisir(n)
  res <- SommeDiviseurs(n)
  Ecrire_nl("La somme des diviseurs de ", n, " est : ", res)
FIN

Tableau de déclaration des objets globaux
Objet            Type / Nature
Saisir           Procédure
SommeDiviseurs   Fonction
n, res           Entier
